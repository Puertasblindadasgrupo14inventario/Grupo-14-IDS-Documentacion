        </mxCell>
        <mxCell id="FlujoGeneral-69" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="37. Confirmar el registro del evento">
