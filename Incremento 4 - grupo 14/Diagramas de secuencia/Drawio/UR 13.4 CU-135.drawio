        <mxCell id="FlujoGeneral-70" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="38. Confirmar el registro de la auditoría">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1830" y="2226" as="sourcePoint" />
            <mxPoint x="1450" y="2226" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-71" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="39. Retornar la confirmación; las reservas se mantienen y la vinculación vuelve a ser modificable">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="2264" as="sourcePoint" />
            <mxPoint x="670" y="2264" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-72" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="40. Muestra el pedido en &quot;Vinculado&quot;,&lt;br&gt;con su vinculación modificable">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="2316" as="sourcePoint" />
            <mxPoint x="370" y="2316" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
