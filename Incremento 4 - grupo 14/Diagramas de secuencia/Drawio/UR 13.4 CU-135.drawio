        <mxCell id="FlujoGeneral-64" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="32. Insertar el estado &quot;Vinculado&quot;&lt;br&gt;con el usuario y la fecha">
