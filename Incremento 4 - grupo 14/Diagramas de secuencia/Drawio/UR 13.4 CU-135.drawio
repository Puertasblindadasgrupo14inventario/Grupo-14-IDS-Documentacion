            <mxPoint x="1450" y="2112" as="sourcePoint" />
            <mxPoint x="1830" y="2112" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-68" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="36. Insertar el evento con el motivo de la vuelta a &quot;Vinculado&quot;, el usuario y la fecha">
          <mxGeometry relative="1" as="geometry">
