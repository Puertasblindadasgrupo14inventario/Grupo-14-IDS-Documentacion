              <mxPoint x="1185" y="1622" />
            </Array>
            <mxPoint x="1060" y="1576" as="sourcePoint" />
            <mxPoint x="1060" y="1622" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-57" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="25. Solicitar registrar la confirmación exitosa">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="1662" as="sourcePoint" />
            <mxPoint x="1830" y="1662" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-58" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="26. Insertar el intento exitoso con el usuario, la acción, la fecha y la hora">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1840" y="1700" as="sourcePoint" />
            <mxPoint x="3030" y="1700" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-59" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="27. Confirmar el registro del intento">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3030" y="1738" as="sourcePoint" />
            <mxPoint x="1840" y="1738" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-60" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="28. Confirmar la persistencia de la confirmación">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1830" y="1776" as="sourcePoint" />
            <mxPoint x="1060" y="1776" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-61" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="29. Retornar el token de confirmación, válido&lt;br&gt;por 5 minutos y solo para esta acción">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="1828" as="sourcePoint" />
            <mxPoint x="670" y="1828" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-62" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="30. Enviar la vuelta a &quot;Vinculado&quot; con el motivo y el token de confirmación">
          <mxGeometry relative="1" as="geometry">
