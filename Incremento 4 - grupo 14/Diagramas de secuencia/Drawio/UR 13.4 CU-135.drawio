        <mxCell id="FlujoGeneral-63" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="31. Solicitar registrar el nuevo estado,&lt;br&gt;revalidando dentro de la transacción">
