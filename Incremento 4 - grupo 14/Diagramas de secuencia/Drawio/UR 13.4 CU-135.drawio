        <mxCell id="FlujoGeneral-65" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="33. Confirmar el registro del estado">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2130" y="2008" as="sourcePoint" />
            <mxPoint x="1840" y="2008" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-66" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="34. Confirmar la persistencia del nuevo estado">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1830" y="2046" as="sourcePoint" />
            <mxPoint x="1450" y="2046" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-67" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="35. Solicitar registrar el motivo de la&lt;br&gt;vuelta a &quot;Vinculado&quot; en la auditoría,&lt;br&gt;después de confirmar la operación">
