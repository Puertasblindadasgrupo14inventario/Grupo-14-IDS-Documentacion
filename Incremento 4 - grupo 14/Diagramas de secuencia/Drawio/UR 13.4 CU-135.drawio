        <mxCell id="FlujoGeneral-41" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="9. Verificar que el pedido no esté&lt;br&gt;despachado ni cancelado; no lo está">
