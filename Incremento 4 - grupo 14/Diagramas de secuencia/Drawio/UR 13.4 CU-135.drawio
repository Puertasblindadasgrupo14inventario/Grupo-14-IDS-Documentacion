        <mxCell id="FlujoGeneral-33" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="1. Selecciona un pedido en &quot;Preparado&quot; o&lt;br&gt;&quot;En carga&quot; y elige volverlo a &quot;Vinculado&quot;">
