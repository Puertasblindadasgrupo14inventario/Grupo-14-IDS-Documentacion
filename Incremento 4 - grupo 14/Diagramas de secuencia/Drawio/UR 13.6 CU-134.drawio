          </mxGeometry>
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-52" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="6. Obtener el estado actual del pedido" vertex="1">
          <mxGeometry height="20" width="220" x="1284" y="-895" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-53" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="7. Retornar el pedido en &quot;Preparado&quot; o &quot;En carga&quot;" vertex="1">
          <mxGeometry height="20" width="250" x="1269" y="-855" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-54" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="8. Obtener el insumo del pedido con su cantidad retirada" vertex="1">
          <mxGeometry height="30" width="320" x="1384" y="-800" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-55" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="9. Retornar el insumo con material retirado" vertex="1">
          <mxGeometry height="20" width="240" x="1424" y="-760" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-56" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="10. Entregar el estado del pedido y del insumo" vertex="1">
          <mxGeometry height="30" width="260" x="999" y="-720" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-57" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="11. Verificar que el pedido no esté despachado ni cancelado" vertex="1">
          <mxGeometry height="40" width="240" x="1009" y="-667.42" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-58" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="12. Verificar que el insumo pertenezca al pedido y tenga material retirado" vertex="1">
          <mxGeometry height="40" width="230" x="1029" y="-610" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-59" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="13. Solicitar dejar el insumo pendiente de retiro" vertex="1">
          <mxGeometry height="40" width="220" x="1006.5" y="-560" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-60" parent="1" style="text;whiteSpace=wrap;html=1;" value="14. Dejar en cero la cantidad retirada del insumo y borra el responsable y la hora del retiro" vertex="1">
          <mxGeometry height="40" width="490" x="1299" y="-530" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-61" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="15. Confirmar la actualización del insumo" vertex="1">
          <mxGeometry height="30" width="230" x="1382" y="-490" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-62" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="16. Confirmar la persistencia de la devolución" vertex="1">
          <mxGeometry height="30" width="250" x="1006.5" y="-470" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-63" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="17. Solicitar registrar la devolución a bodega en la auditoría, después de confirmar la operación" vertex="1">
          <mxGeometry height="40" width="240" x="999" y="-420" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-64" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="18. Insertar el evento con la devolución a bodega, el usuario y la fecha" vertex="1">
          <mxGeometry height="30" width="390" x="1404" y="-370" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-65" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="19. Confirmar el registro del evento" vertex="1">
          <mxGeometry height="30" width="200" x="1464" y="-320" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-66" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="20. Confirmar el registro de la auditoría" vertex="1">
          <mxGeometry height="30" width="220" x="1009" y="-280" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-67" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="21. Retornar la confirmación de la devolución" vertex="1">
          <mxGeometry height="30" width="250" x="724" y="-250" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-68" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="22. Muestra el insumo &quot;Pendiente&quot; de retiro, con su reserva intacta" vertex="1">
          <mxGeometry height="40" width="230" x="459" y="-220" as="geometry" />
        </mxCell>
        <mxCell id="8ghPGHLMP70HT-S0Cb_e-69" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="CU-134: Devolviendo a bodega insumos retirados" vertex="1">
          <mxGeometry height="40" width="300" x="1155" y="-1220" as="geometry" />
        </mxCell>
