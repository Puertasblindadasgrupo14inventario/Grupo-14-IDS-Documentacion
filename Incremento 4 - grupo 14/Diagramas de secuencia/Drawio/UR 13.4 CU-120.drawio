        <mxCell id="Excepcion1-29" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="2. Solicitar la vinculación vigente y&lt;br&gt;los insumos sugeridos para la venta">
