        <mxCell id="Excepcion1-33" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="6. Obtener el pedido de instalación de la venta con sus insumos vinculados">
          <mxGeometry relative="1" as="geometry">
