        <mxCell id="Excepcion1-28" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="1. Selecciona una venta en estado &quot;aprobada&quot; o &quot;en&lt;br&gt;proceso&quot; de la lista de pedidos de instalación">
