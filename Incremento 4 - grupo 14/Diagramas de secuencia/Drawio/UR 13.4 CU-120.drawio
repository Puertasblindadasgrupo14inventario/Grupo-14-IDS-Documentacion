        <mxCell id="Excepcion1-49" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="22. Informa la situación y permite cargar los insumos manualmente antes de continuar">
