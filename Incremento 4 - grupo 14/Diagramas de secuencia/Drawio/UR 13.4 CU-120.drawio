        <mxCell id="Excepcion1-46" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="19. Entregar la lista de insumos sugeridos y su stock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1500" y="1318" as="sourcePoint" />
            <mxPoint x="1120" y="1318" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-47" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="20. Verificar los insumos sugeridos y detecta que no hay ninguno">
