        <mxCell id="Excepcion1-32" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="5. Retornar la venta en estado&lt;br&gt;&quot;aprobada&quot; o &quot;en proceso&quot;">
