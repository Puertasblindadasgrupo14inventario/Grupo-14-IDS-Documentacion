        <mxCell id="Excepcion1-31" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="4. Obtener la venta con su estado">
          <mxGeometry relative="1" as="geometry">
