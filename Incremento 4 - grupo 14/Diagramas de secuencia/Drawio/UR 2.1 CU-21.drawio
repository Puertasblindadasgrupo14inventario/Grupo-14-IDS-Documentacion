        <mxCell id="FlujoGeneral-22" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="5. Enviar el nombre, la dirección&lt;br&gt;y el estado de la bodega">
