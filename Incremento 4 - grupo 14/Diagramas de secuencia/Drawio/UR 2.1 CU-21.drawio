        <mxCell id="FlujoGeneral-33" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="16. Retornar la confirmación de la bodega actualizada">
