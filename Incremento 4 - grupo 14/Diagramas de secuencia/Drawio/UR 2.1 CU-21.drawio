        <mxCell id="FlujoGeneral-28" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="11. Comparar los datos anteriores con los&lt;br&gt;nuevos y armar el detalle de los cambios">
