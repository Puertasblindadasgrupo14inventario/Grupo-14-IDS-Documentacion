          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-29" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="12. Solicitar registrar la edición de la bodega en&lt;br&gt;la auditoría, después de confirmar la operación">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="1162" as="sourcePoint" />
            <mxPoint x="1440" y="1162" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-30" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="13. Insertar el evento con el valor anterior y el&lt;br&gt;nuevo de cada campo modificado, el usuario y la fecha">
