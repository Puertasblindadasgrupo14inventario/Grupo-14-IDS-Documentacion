        </mxCell>
        <mxCell id="FlujoGeneral-23" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="6. Solicitar actualizar la bodega,&lt;br&gt;leyendo antes sus datos vigentes">
