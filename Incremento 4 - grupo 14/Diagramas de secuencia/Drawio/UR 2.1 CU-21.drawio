        <mxCell id="FlujoGeneral-24" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="7. Obtener los datos vigentes y actualizar&lt;br&gt;el nombre, la dirección y el estado">
