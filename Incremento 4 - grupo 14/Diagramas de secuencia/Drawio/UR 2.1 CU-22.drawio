        </mxCell>
        <mxCell id="FlujoGeneral-21" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="1. Accede al detalle de la&lt;br&gt;bodega y elige editarla">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="544" as="sourcePoint" />
            <mxPoint x="660" y="544" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-22" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="2. Muestra el formulario con el nombre,&lt;br&gt;la dirección y el estado vigentes">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="596" as="sourcePoint" />
            <mxPoint x="370" y="596" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-23" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="3. Cambia el estado a &quot;Inactiva&quot; y guarda">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="634" as="sourcePoint" />
            <mxPoint x="660" y="634" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-24" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="4. Verificar que el nombre no&lt;br&gt;esté vacío">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="795" y="658" />
              <mxPoint x="795" y="704" />
            </Array>
            <mxPoint x="670" y="658" as="sourcePoint" />
            <mxPoint x="670" y="704" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-25" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="5. Enviar los datos de la bodega con el estado &quot;Inactiva&quot;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="670" y="744" as="sourcePoint" />
            <mxPoint x="1050" y="744" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-26" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="6. Consultar el stock físico de la bodega">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="782" as="sourcePoint" />
            <mxPoint x="1440" y="782" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-27" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="7. Obtener la suma del&lt;br&gt;stock físico de la bodega">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1450" y="834" as="sourcePoint" />
            <mxPoint x="1740" y="834" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-28" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="8. Retornar el stock&lt;br&gt;físico total, que es cero">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1740" y="886" as="sourcePoint" />
            <mxPoint x="1450" y="886" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-29" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="9. Entregar el stock físico total">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="924" as="sourcePoint" />
            <mxPoint x="1060" y="924" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-30" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="10. Verificar que la bodega no&lt;br&gt;tenga stock físico y detecta que no tiene">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1185" y="948" />
              <mxPoint x="1185" y="994" />
            </Array>
            <mxPoint x="1060" y="948" as="sourcePoint" />
            <mxPoint x="1060" y="994" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-31" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="11. Solicitar actualizar la bodega,&lt;br&gt;leyendo antes sus datos vigentes">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="1048" as="sourcePoint" />
            <mxPoint x="1440" y="1048" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-32" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="12. Obtener los datos vigentes y cambiar el estado de la bodega a &quot;Inactiva&quot;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1450" y="1086" as="sourcePoint" />
            <mxPoint x="2040" y="1086" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-33" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="13. Retornar los datos anteriores y los nuevos">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2040" y="1124" as="sourcePoint" />
            <mxPoint x="1450" y="1124" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-34" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="14. Entregar el resultado de la actualización">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1162" as="sourcePoint" />
            <mxPoint x="1060" y="1162" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-35" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="15. Verificar que la bodega&lt;br&gt;exista, detecta que sí existe y quedó inactiva">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1185" y="1186" />
              <mxPoint x="1185" y="1232" />
            </Array>
            <mxPoint x="1060" y="1186" as="sourcePoint" />
            <mxPoint x="1060" y="1232" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-36" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="16. Solicitar registrar la desactivación de la bodega&lt;br&gt;en la auditoría, después de confirmar la operación">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="1286" as="sourcePoint" />
            <mxPoint x="1440" y="1286" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-37" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="17. Insertar el evento con el estado anterior y el nuevo de la bodega, el usuario y la fecha">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1450" y="1324" as="sourcePoint" />
            <mxPoint x="2340" y="1324" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-38" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="18. Confirmar el registro del evento">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2340" y="1362" as="sourcePoint" />
            <mxPoint x="1450" y="1362" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-39" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="19. Confirmar el registro de la auditoría">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="1400" as="sourcePoint" />
            <mxPoint x="1060" y="1400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-40" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="20. Retornar la confirmación de la bodega actualizada">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1050" y="1438" as="sourcePoint" />
            <mxPoint x="670" y="1438" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="FlujoGeneral-41" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="21. Muestra la bodega como inactiva: no&lt;br&gt;se ofrece en el registro de entradas y&lt;br&gt;no admite traslados ni ajustes de stock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="1504" as="sourcePoint" />
            <mxPoint x="370" y="1504" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
