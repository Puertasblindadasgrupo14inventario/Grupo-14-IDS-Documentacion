        <mxCell id="FlujoGeneral-16" parent="FlujoGeneral-10" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="50" width="10" x="95" y="898" as="geometry" />
