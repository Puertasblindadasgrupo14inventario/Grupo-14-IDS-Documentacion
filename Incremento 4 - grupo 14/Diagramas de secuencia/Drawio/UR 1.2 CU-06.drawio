        <mxCell id="FlujoGeneral-35" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="12. Obtener un producto con el SKU&lt;br&gt;nuevo, sin distinguir mayúsculas">
