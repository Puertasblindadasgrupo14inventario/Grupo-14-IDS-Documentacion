        <mxCell id="FlujoGeneral-32" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="9. Entregar el producto base">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1440" y="896" as="sourcePoint" />
            <mxPoint x="1060" y="896" as="targetPoint" />
          </mxGeometry>
