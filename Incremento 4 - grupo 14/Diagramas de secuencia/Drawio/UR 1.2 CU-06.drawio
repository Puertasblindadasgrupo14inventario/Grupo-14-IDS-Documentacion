        <mxCell id="FlujoGeneral-27" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="4. Verificar que se haya ingresado&lt;br&gt;el SKU nuevo">
