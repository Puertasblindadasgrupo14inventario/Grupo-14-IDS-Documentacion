        <mxCell id="FlujoGeneral-25" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="2. Muestra el SKU del producto base&lt;br&gt;y solicita el SKU del producto nuevo">
