        <mxCell id="FlujoGeneral-33" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="10. Verificar que el producto&lt;br&gt;base siga registrado">
