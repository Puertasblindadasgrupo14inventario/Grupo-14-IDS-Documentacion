          </mxGeometry>
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-51" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="6. Envíar la contraseña y la acción a confirmar" vertex="1">
          <mxGeometry height="30" width="260" x="-32.5" y="-1060" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-52" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="7. Consultar la credencial del usuario y sus intentos de confirmación recientes" vertex="1">
          <mxGeometry height="40" width="430" x="331" y="-1050" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-53" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="8. Obtener la credencial almacenada del usuario" vertex="1">
          <mxGeometry height="20" width="280" x="806" y="-1030" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-54" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="9. Retornar la credencial del usuario" vertex="1">
          <mxGeometry height="30" width="210" x="830" y="-990" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-55" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="10. Obtener los intentos fallidos recientes del usuario" vertex="1">
          <mxGeometry height="20" width="290" x="910" y="-946" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-56" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="11. Retorna los intentos fallidos" vertex="1">
          <mxGeometry height="20" width="230" x="970" y="-905" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-57" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="12. Entregar la credencial y los intentos fallidos" vertex="1">
          <mxGeometry height="20" width="260" x="390" y="-878.71" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-58" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="13. Comparar la contraseña ingresada con la credencial del usuario" vertex="1">
          <mxGeometry height="30" width="370" x="300" y="-820" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-59" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="">
