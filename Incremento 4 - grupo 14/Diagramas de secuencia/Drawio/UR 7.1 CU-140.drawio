        <mxCell id="ZIMnOe84F0AAywOuAbNr-45" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="1. Elige eliminar un proveedor de la lista" vertex="1">
          <mxGeometry height="30" width="230" x="-275" y="-1260" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-46" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="2. Solicita confirmar e informa que el proveedor se desactiva si tiene información asociada" vertex="1">
          <mxGeometry height="40" width="230" x="-275" y="-1230" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-47" parent="1" style="text;whiteSpace=wrap;html=1;" value="3. Confirma la eliminación" vertex="1">
          <mxGeometry height="20" width="160" x="-240" y="-1171" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-48" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="4. Solicita confirmar la eliminación del proveedor con su contraseña" vertex="1">
          <mxGeometry height="40" width="260" x="-290" y="-1133" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-49" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="5. Ingresa su contraseña" vertex="1">
          <mxGeometry height="30" width="150" x="-245" y="-1087.42" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-50" edge="1" parent="1" source="ZIMnOe84F0AAywOuAbNr-19" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="">
