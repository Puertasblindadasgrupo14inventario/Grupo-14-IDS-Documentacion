        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-66" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="18. Retornar el rechazo de la confirmación sin entregar el token" vertex="1">
          <mxGeometry height="40" width="280" x="-35" y="-690" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-67" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="19. Informa que la contraseña es incorrecta y rechaza la operación sin cambios" vertex="1">
