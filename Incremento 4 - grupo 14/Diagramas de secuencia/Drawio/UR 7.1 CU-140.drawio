        <mxCell id="ZIMnOe84F0AAywOuAbNr-62" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="14. Solicitar registrar el intento fallido" vertex="1">
          <mxGeometry height="20" width="210" x="441" y="-790" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-63" parent="1" style="text;whiteSpace=wrap;html=1;" value="15. Insertar el intento fallido con el usuario, la acción, la fecha y la hora" vertex="1">
          <mxGeometry height="30" width="390" x="910" y="-760" as="geometry" />
        </mxCell>
