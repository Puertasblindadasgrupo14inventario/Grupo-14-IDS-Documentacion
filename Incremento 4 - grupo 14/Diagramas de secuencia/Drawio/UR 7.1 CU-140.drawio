          <mxGeometry height="30" width="200" x="985" y="-720" as="geometry" />
        </mxCell>
        <mxCell id="ZIMnOe84F0AAywOuAbNr-65" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="17. Confirmar la persistencia del intento fallido" vertex="1">
