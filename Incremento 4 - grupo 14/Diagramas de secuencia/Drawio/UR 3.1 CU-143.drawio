        <mxCell id="FlujoGeneral-64" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="22. Entregar la credencial y los intentos fallidos">
