          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-69" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="33. Obtener la bodega">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1988" as="sourcePoint" />
            <mxPoint x="3050" y="1988" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-70" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="34. Retornar la bodega, activa">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3050" y="2026" as="sourcePoint" />
            <mxPoint x="2160" y="2026" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-71" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="35. Obtener y bloquear las filas de stock del producto en la bodega">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="2064" as="sourcePoint" />
            <mxPoint x="3650" y="2064" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-72" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="36. Retornar la cantidad física y la reservada; lo reservado es mayor que la cantidad nueva">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="3650" y="2102" as="sourcePoint" />
            <mxPoint x="2160" y="2102" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-73" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="37. Entregar el producto, la bodega y el stock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="2140" as="sourcePoint" />
            <mxPoint x="1770" y="2140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-74" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="38. Verificar que el producto y la&lt;br&gt;bodega estén activos; lo están">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1895" y="2164" />
              <mxPoint x="1895" y="2210" />
            </Array>
            <mxPoint x="1770" y="2164" as="sourcePoint" />
            <mxPoint x="1770" y="2210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-75" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="39. Verificar que la cantidad registrada&lt;br&gt;sea la que se mostró; no cambió">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1895" y="2236" />
              <mxPoint x="1895" y="2282" />
            </Array>
            <mxPoint x="1770" y="2236" as="sourcePoint" />
            <mxPoint x="1770" y="2282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-76" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="40. Calcular la diferencia y verificar&lt;br&gt;la cantidad nueva; detecta que queda&lt;br&gt;por debajo de lo reservado">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1895" y="2308" />
              <mxPoint x="1895" y="2368" />
            </Array>
            <mxPoint x="1770" y="2308" as="sourcePoint" />
            <mxPoint x="1770" y="2368" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-77" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="41. Retornar el rechazo con la cantidad reservada, sin mover el stock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1760" y="2408" as="sourcePoint" />
            <mxPoint x="690" y="2408" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion1-78" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="42. Informa que la cantidad nueva no&lt;br&gt;es válida (igual a la registrada,&lt;br&gt;negativa, bajo lo reservado o sin&lt;br&gt;motivo) y que el stock no cambió">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="2488" as="sourcePoint" />
            <mxPoint x="370" y="2488" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
