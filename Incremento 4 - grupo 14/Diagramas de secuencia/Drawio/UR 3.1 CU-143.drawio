        <mxCell id="FlujoGeneral-65" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="23. Comparar la contraseña ingresada con&lt;br&gt;la credencial del usuario; coinciden">
