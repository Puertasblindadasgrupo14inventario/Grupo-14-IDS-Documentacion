        </mxCell>
        <mxCell id="Excepcion2-45" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="9. Muestra las bodegas activas con&lt;br&gt;la cantidad registrada en cada una">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="896" as="sourcePoint" />
            <mxPoint x="370" y="896" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-46" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="10. Elige la bodega e ingresa la&lt;br&gt;cantidad que hay físicamente y el motivo">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="948" as="sourcePoint" />
            <mxPoint x="680" y="948" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-47" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="11. Calcular la diferencia&lt;br&gt;con la cantidad registrada">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="815" y="972" />
              <mxPoint x="815" y="1018" />
            </Array>
            <mxPoint x="690" y="972" as="sourcePoint" />
            <mxPoint x="690" y="1018" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-48" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="12. Muestra que se registrará&lt;br&gt;una entrada por la diferencia">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="1072" as="sourcePoint" />
            <mxPoint x="370" y="1072" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-49" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="13. Confirma el ajuste">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="1110" as="sourcePoint" />
            <mxPoint x="680" y="1110" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-50" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="14. Solicita confirmar el ajuste&lt;br&gt;del stock con su contraseña">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="1162" as="sourcePoint" />
            <mxPoint x="370" y="1162" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-51" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="15. Ingresa su contraseña">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="1200" as="sourcePoint" />
            <mxPoint x="680" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-52" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="16. Enviar la contraseña y la acción&lt;br&gt;a confirmar (el ajuste del stock)">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="1252" as="sourcePoint" />
            <mxPoint x="1070" y="1252" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-53" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="17. Consultar la credencial del usuario y sus intentos de confirmación recientes">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="1290" as="sourcePoint" />
            <mxPoint x="2150" y="1290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-54" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="18. Obtener la credencial&lt;br&gt;almacenada del usuario">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1342" as="sourcePoint" />
            <mxPoint x="2450" y="1342" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-55" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="19. Retornar la credencial del usuario">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2450" y="1380" as="sourcePoint" />
            <mxPoint x="2160" y="1380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-56" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="20. Obtener los intentos fallidos recientes del usuario">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1418" as="sourcePoint" />
            <mxPoint x="2750" y="1418" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-57" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="21. Retornar los intentos fallidos; no hay un bloqueo vigente">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2750" y="1456" as="sourcePoint" />
            <mxPoint x="2160" y="1456" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-58" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="22. Entregar la credencial y los intentos fallidos">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="1494" as="sourcePoint" />
            <mxPoint x="1080" y="1494" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-59" edge="1" parent="1" style="html=1;verticalAlign=middle;endArrow=block;rounded=0;startArrow=none;startFill=0;endFill=1;" value="23. Comparar la contraseña ingresada con&lt;br&gt;la credencial del usuario; coinciden">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1205" y="1518" />
              <mxPoint x="1205" y="1564" />
            </Array>
            <mxPoint x="1080" y="1518" as="sourcePoint" />
            <mxPoint x="1080" y="1564" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-60" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="24. Solicitar registrar la confirmación exitosa">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1080" y="1604" as="sourcePoint" />
            <mxPoint x="2150" y="1604" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-61" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="25. Insertar el intento exitoso con el usuario, la acción, la fecha y la hora">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2160" y="1642" as="sourcePoint" />
            <mxPoint x="2750" y="1642" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-62" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="26. Confirmar el registro del intento">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2750" y="1680" as="sourcePoint" />
            <mxPoint x="2160" y="1680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-63" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="27. Confirmar la persistencia de la confirmación">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2150" y="1718" as="sourcePoint" />
            <mxPoint x="1080" y="1718" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-64" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;dashed=1;endFill=1;" value="28. Retornar el token de confirmación, válido&lt;br&gt;por 5 minutos y solo para esta acción">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1070" y="1770" as="sourcePoint" />
            <mxPoint x="690" y="1770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-65" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="29. Enviar el ajuste (bodega, cantidad registrada que se mostró, cantidad nueva y motivo) con el token de confirmación">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="1808" as="sourcePoint" />
            <mxPoint x="1760" y="1808" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Excepcion2-66" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" value="30. Consultar el producto, la bodega y el&lt;br&gt;stock del producto en ella, bloqueando&lt;br&gt;el producto y sus filas de stock">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1770" y="1874" as="sourcePoint" />
            <mxPoint x="2150" y="1874" as="targetPoint" />
          </mxGeometry>
        </mxCell>
