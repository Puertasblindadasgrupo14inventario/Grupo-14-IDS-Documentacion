        <mxCell id="_c9hJiVYKfg5Ocmds24Z-7" parent="_c9hJiVYKfg5Ocmds24Z-1" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=11;align=left;verticalAlign=top;spacing=8;" value="&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;INVENTARIO&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 16px; white-space: nowrap; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;+ Servidor Web (Node.js + Express)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px; text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;&quot;&gt;+ API REST del sistema&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Auth / JWT (Control de sesiones y tokens)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Middleware de Control de Acceso (RBAC)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Lógica de negocio centralizada&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Conexión transaccional PostgreSQL&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Servicios de inventario, gestión de stock,&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp;gestión de producción,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;pedidos y compras, alertas,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;&amp;nbsp; &amp;nbsp;reportes y administración&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Generación de reportes y documentos PDF,CSV&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Endpoints de recuperación de contraseña&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Servicio de correos transaccionales (Infranetworking)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Gestión de Auditoría y Registro de Logs&lt;/div&gt;&lt;div style=&quot;&quot;&gt;+ Hosting y enrutamiento para las vistas (Frontend SPA)&lt;br&gt;+ EncriptarPasswordBcrypt()&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;+ RuntimeNodeJS(): void&lt;/span&gt;&lt;br style=&quot;white-space: normal;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+alertasController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+alertasFaltantesController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+auditoriaController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+authController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+bodegasController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+catalogosController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+clasificacionController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+codigosController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+conteosController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+facturasController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+herramientasController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+insumosEspecialesController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+integracionController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+materialesController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+movimientosController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+notificacionesController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;+ordenesTrabajoController&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;.js&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&qu